{
  "info": {
    "name": "EFT DSY2207 - Usuarios y Roles con Azure Event Grid",
    "description": "Variable {{bff}} apunta al BFF desplegado en Azure App Service. Los requests de creacion guardan automaticamente el id en variables de la coleccion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "bff",
      "value": "https://app-bff-eft-zsjou.azurewebsites.net"
    },
    {
      "key": "fnUsuarios",
      "value": "https://fn-usuarios-eft-zsjou.azurewebsites.net"
    },
    {
      "key": "fnRoles",
      "value": "https://fn-roles-eft-zsjou.azurewebsites.net"
    },
    {
      "key": "fnEventos",
      "value": "https://fn-eventos-eft-zsjou.azurewebsites.net"
    },
    {
      "key": "usuarioId",
      "value": "4"
    },
    {
      "key": "usuarioConRolId",
      "value": "5"
    },
    {
      "key": "rolId",
      "value": "4"
    }
  ],
  "item": [
    {
      "name": "0. Demo video (reglas con eventos)",
      "item": [
        {
          "name": "1. Crear usuario SIN rol (BFF REST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bff}}/api/bff/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Sofia Torres\",\n  \"username\": \"storres\",\n  \"email\": \"sofia.torres@duocuc.cl\",\n  \"activo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "pm.collectionVariables.set('usuarioId', datos.id);",
                  "pm.test('id guardado en {{usuarioId}}', () => pm.expect(datos.id).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Ver usuario -> rol CONSULTA asignado por evento",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bff}}/api/bff/usuarios/{{usuarioId}}"
          }
        },
        {
          "name": "3. Crear rol (BFF GraphQL)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bff}}/api/bff/graphql/roles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"FINANZAS\",\n  \"descripcion\": \"Area de finanzas\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "pm.collectionVariables.set('rolId', datos.id);",
                  "pm.test('id guardado en {{rolId}}', () => pm.expect(datos.id).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Crear usuario CON ese rol (BFF GraphQL)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bff}}/api/bff/graphql/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Pedro Lagos\",\n  \"username\": \"plagos\",\n  \"email\": \"pedro.lagos@duocuc.cl\",\n  \"activo\": true,\n  \"rolId\": {{rolId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "pm.collectionVariables.set('usuarioConRolId', datos.id);",
                  "pm.test('id guardado en {{usuarioConRolId}}', () => pm.expect(datos.id).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Eliminar el rol (BFF GraphQL)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{bff}}/api/bff/graphql/roles/{{rolId}}"
          }
        },
        {
          "name": "6. Ver usuario -> quedo sin rol por evento",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bff}}/api/bff/graphql/usuarios/{{usuarioConRolId}}"
          }
        },
        {
          "name": "7. Historial de eventos (auditoria)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bff}}/api/bff/eventos/auditoria"
          }
        },
        {
          "name": "8. Notificaciones generadas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bff}}/api/bff/eventos/notificaciones"
          }
        },
        {
          "name": "9. Validacion: rol inexistente -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bff}}/api/bff/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Test\",\n  \"username\": \"test999\",\n  \"email\": \"test999@duocuc.cl\",\n  \"rolId\": 999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
